set.seed(1234)
k_candidates <- c(10, 12, 15, 18, 20)
k_result <- stm::searchK(
documents = out$documents,
vocab = out$vocab,
K = k_candidates,
prevalence = ~ year + source,
data = out$meta,
init.type = "Spectral",
heldout.seed = 1234
)
k_diagnostics <- k_result$results |>
as_tibble() |>
mutate(
K = as.integer(K),
exclus = as.numeric(exclus),
semcoh = as.numeric(semcoh),
heldout = as.numeric(heldout),
residual = as.numeric(residual)
) |>
arrange(K)
print(k_diagnostics)
plot(k_result)
K_final <- 12
set.seed(1234)
mod_stm_vet <- stm::stm(
documents = out$documents,
vocab = out$vocab,
K = K_final,
prevalence = ~ year + source,
data = out$meta,
init.type = "Spectral",
seed = 1234,
max.em.its = 250
)
print(mod_stm_vet$convergence)
stopifnot(
nrow(mod_stm_vet$theta) ==
length(out$documents)
)
stopifnot(
ncol(mod_stm_vet$theta) ==
K_final
)
stopifnot(
all(
abs(
rowSums(mod_stm_vet$theta) - 1
) < 1e-6
)
if (!isTRUE(mod_stm_vet$convergence$converged)) {
warning(
"Final STM did not converge within the specified iteration limit."
)
}
topic_labels <- stm::labelTopics(
mod_stm_vet,
n = 20
)
print(topic_labels)
capture.output(
topic_labels,
file = file.path(
output_dir,
"reddit_stm_topic_labels.txt"
)
