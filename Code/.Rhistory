library(stm)
library(ggplot2)
library(readr)
library(stringr)
library(forcats)
input_dir  <- "Output/stm_corpus"
model_dir  <- "Output/reddit_stm"
output_dir <- "Output/esfi_stm"
figure_dir <- file.path(output_dir, "figures")
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(figure_dir, recursive = TRUE, showWarnings = FALSE)
model_file <- file.path(
model_dir, "reddit_stm_model_final.rds")
meta_file <- file.path(
input_dir,"reddit_meta_stm_final.rds")
mod_stm_vet <- readRDS(model_file)
meta_stm    <- readRDS(meta_file)
cat("STM topics:", ncol(mod_stm_vet$theta), "\n")
cat("STM documents:", nrow(mod_stm_vet$theta), "\n")
cat("Metadata rows:", nrow(meta_stm), "\n")
cat("Model class:", paste(class(mod_stm_vet), collapse = ", "), "\n")
cat("Number of topics:", ncol(mod_stm_vet$theta), "\n")
cat("Number of STM documents:", nrow(mod_stm_vet$theta), "\n")
cat("Number of metadata rows:", nrow(meta_stm), "\n\n")
cat("Metadata variables:\n")
print(names(meta_stm))
if (ncol(mod_stm_vet$theta) != 12) {
stop("The loaded STM model does not contain 12 topics.")
}
if (nrow(mod_stm_vet$theta) != nrow(meta_stm)) {
stop(
"The number of STM documents does not match the number of metadata rows."
)
}
required_vars <- c("frag_hits", "frag_index")
missing_vars <- setdiff(required_vars, names(meta_stm))
if (length(missing_vars) > 0) {
stop(
"The following required ESFI variables are missing from metadata: ",
paste(missing_vars, collapse = ", ")
)
}
# Search all RDS files under Output for ESFI variables
rds_files <- list.files(
"Output",
pattern = "\\.rds$",
recursive = TRUE,
full.names = TRUE
)
esfi_file_audit <- lapply(rds_files, function(f) {
obj <- tryCatch(
readRDS(f),
error = function(e) NULL
)
if (is.null(obj)) {
return(NULL)
}
object_names <- names(obj)
if (is.null(object_names)) {
return(NULL)
}
has_frag_hits  <- "frag_hits" %in% object_names
has_frag_index <- "frag_index" %in% object_names
if (has_frag_hits || has_frag_index) {
data.frame(
file = f,
class = paste(class(obj), collapse = ", "),
n_rows = if (!is.null(nrow(obj))) nrow(obj) else NA_integer_,
has_frag_hits = has_frag_hits,
has_frag_index = has_frag_index,
stringsAsFactors = FALSE
)
} else {
NULL
}
})
esfi_file_audit <- do.call(
rbind,
esfi_file_audit
)
print(esfi_file_audit, row.names = FALSE)
dfm_file <- file.path(
"Data",
"dfm_vet_analysis_final.rds"
)
dictionary_file <- file.path(
"Output",
"esfi_dictionary_development",
"esfi_dict_final.rds"
)
required_files <- c(
dfm_file,
dictionary_file,
model_file,
meta_file
)
missing_files <- required_files[
!file.exists(required_files)
]
if (length(missing_files) > 0) {
stop(
"The following required files could not be found:\n",
paste(missing_files, collapse = "\n")
)
}
dfm_vet_analysis <- readRDS(dfm_file)
esfi_dict_final  <- readRDS(dictionary_file)
mod_stm_vet      <- readRDS(model_file)
meta_stm         <- readRDS(meta_file)
cat("Model class:", paste(class(mod_stm_vet), collapse = ", "), "\n")
cat("Number of topics:", ncol(mod_stm_vet$theta), "\n")
cat("Number of STM documents:", nrow(mod_stm_vet$theta), "\n")
cat("Number of metadata rows:", nrow(meta_stm), "\n\n")
cat("Metadata variables:\n")
print(names(meta_stm))
cat("Documents in ESFI DFM:", quanteda::ndoc(dfm_vet_analysis), "\n")
cat("Documents in STM model:", nrow(mod_stm_vet$theta), "\n")
cat("Rows in STM metadata:", nrow(meta_stm), "\n\n")
cat("First ESFI DFM document names:\n")
print(head(quanteda::docnames(dfm_vet_analysis)))
cat("\nSTM metadata variables:\n")
print(names(meta_stm))
dfm_docvars <- quanteda::docvars(dfm_vet_analysis)
names(dfm_docvars)
sum(is.na(esfi_scores$comment_id))
dfm_esfi_terms <- quanteda::dfm_select(
dfm_vet_analysis,
pattern = esfi_dict_final,
valuetype = "glob",
selection = "keep"
)
esfi_scores <- tibble::tibble(
comment_id = as.character(
quanteda::docvars(dfm_vet_analysis, "comment_id")
),
esfi_hits = as.numeric(
quanteda::rowSums(dfm_esfi_terms)
)
) |>
dplyr::mutate(
esfi_present = esfi_hits > 0
)
# Check uniqueness. All should be 0.
sum(is.na(esfi_scores$comment_id))
sum(duplicated(esfi_scores$comment_id))
sum(is.na(meta_stm$comment_id))
sum(duplicated(meta_stm$comment_id))
output_dir  <- file.path("Output", "esfi_dictionary_development")
quanteda::docvars(dfm_vet_analysis, "esfi_hits") <- as.numeric(esfi_hits)
quanteda::docvars(dfm_vet_analysis, "esfi_present") <- esfi_present
saveRDS(
dfm_vet_analysis,
file.path(
output_dir,
"dfm_vet_analysis_with_esfi.rds"
)
esfi_document_scores <- quanteda::docvars(dfm_vet_analysis) |>
tibble::as_tibble() |>
dplyr::mutate(
original_document_number = seq_len(n()),
document_name = quanteda::docnames(dfm_vet_analysis),
esfi_hits = as.numeric(esfi_hits),
esfi_present = esfi_present
)
saveRDS(
esfi_document_scores,
file.path(
output_dir,
"esfi_document_scores.rds"
)
readr::write_csv(
esfi_document_scores,
file.path(
output_dir,
"esfi_document_scores.csv"
)
